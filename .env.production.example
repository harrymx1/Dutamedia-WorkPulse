# =============================================================================
# WorkPulse Production Environment Variables Reference (v1.0.0-rc1)
# PT Dutamedia Mandiri Pratama
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & NETWORKING
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# URL Frontend resmi untuk CORS Whitelist & Pengalihan Auth
# Ganti dengan domain publik resmi (Contoh: https://workpulse.dutamedia.com)
FRONTEND_URL="https://workpulse.dutamedia.com"

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase PostgreSQL / Cloud Hosted)
# -----------------------------------------------------------------------------
# DATABASE_URL: Gunakan Supabase Transaction Pooler (Port 6543) untuk Prisma Client
# format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# DIRECT_URL: Gunakan Direct Database Connection (Port 5432) untuk Prisma Migrations
# format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# SUPABASE_PROJECT_REF: Subdomain project Supabase (misal: yzsischopwnhztjguoxs)
SUPABASE_PROJECT_REF="your-supabase-project-ref"

# -----------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECRETS (JWT, CSRF, SESSION)
# -----------------------------------------------------------------------------
# PERINGATAN KEAMANAN: Minimal 64 karakter acak cryptographically secure (openssl rand -hex 32)
JWT_SECRET="ganti-dengan-kunci-rahasia-minimal-64-karakter-heksadesimal-acak-produksi"
JWT_EXPIRES_IN="8h"

# -----------------------------------------------------------------------------
# 4. SECURITY & RATE LIMITING (DDoS & Brute-Force Prevention)
# -----------------------------------------------------------------------------
# Batas login per IP (default: 20 per menit)
AUTH_RATE_LIMIT=20

# Batas umum request API per IP (default: 100 per menit)
GLOBAL_RATE_LIMIT=100

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & NOTIFICATIONS (Brevo / Sendinblue)
# -----------------------------------------------------------------------------
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="notifications@dutamedia.com"
BREVO_SENDER_NAME="WorkPulse Dutamedia"

# Web Push Notification VAPID Keys (Opsional - Browser Push)
VAPID_PUBLIC_KEY="placeholder-vapid-public-key"
VAPID_PRIVATE_KEY="placeholder-vapid-private-key"
VAPID_SUBJECT="mailto:admin@dutamedia.com"

# -----------------------------------------------------------------------------
# 6. OBJECT STORAGE / EVIDENCE ATTACHMENTS (S3 / Cloudflare R2 / Supabase Storage)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="ganti-dengan-access-key"
STORAGE_SECRET_KEY="ganti-dengan-secret-key"
STORAGE_BUCKET="workpulse-evidence-prod"
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# 7. FRONTEND BUILD TIME VARIABLES (frontend/.env.production)
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL: Gunakan '/api' jika di-reverse proxy oleh Nginx/Cloudflare,
# atau URL absolut 'https://api.workpulse.dutamedia.com' jika domain backend terpisah.
VITE_API_BASE_URL="/api"

