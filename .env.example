# =============================================================================
# WorkPulse Monorepo Environment Variables Reference (SAD §21.2)
# =============================================================================

# Backend (copy to backend/.env)
# -----------------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
# JWT_SECRET="your-super-secret-jwt-key"
# ALLOWED_ORIGIN="http://localhost:5173"
# BREVO_API_KEY="xkeysib-your-brevo-api-key"
# BREVO_SENDER_EMAIL="notifications@dutamedia.com"
# BREVO_SENDER_NAME="WorkPulse Notification"
# STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY="your-storage-access-key"
# STORAGE_SECRET_KEY="your-storage-secret-key"
# STORAGE_BUCKET="workpulse-evidence"
# STORAGE_REGION="auto"

# Frontend (copy to frontend/.env)
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL="http://localhost:3000/api/v1"
