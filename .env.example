# =============================================================================
# WorkPulse Monorepo Environment Variables Reference (SAD v2.1.0)
# =============================================================================

# Backend Environment (.env atau environment container)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://workpulse_app:workpulse_dev_password@localhost:5432/workpulse_dev"
JWT_SECRET="development-super-secret-key-at-least-32-chars-long!"
SESSION_SECRET="development-session-secret-key-at-least-32-chars-long!"
ALLOWED_ORIGIN="http://localhost:5173"

# Notifikasi (Fase P5)
# -----------------------------------------------------------------------------
BREVO_API_KEY="xkeysib-placeholder-until-phase-p5"
BREVO_SENDER_EMAIL="notifications@dutamedia.com"
BREVO_SENDER_NAME="WorkPulse Dutamedia"
VAPID_PUBLIC_KEY="placeholder-vapid-public-key"
VAPID_PRIVATE_KEY="placeholder-vapid-private-key"
VAPID_SUBJECT="mailto:admin@dutamedia.com"

# Object Storage / Evidence Attachments (MinIO / S3 Compatible)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="workpulse-evidence"
STORAGE_REGION="us-east-1"
STORAGE_FORCE_PATH_STYLE=true

# Frontend Environment (frontend/.env)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL="/api"
