datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE

  @@map("user_status_enum")
}

enum InvitationStatus {
  PENDING
  USED
  REVOKED
  EXPIRED

  @@map("invitation_status_enum")
}

enum CanonicalRole {
  EMPLOYEE
  SUPERVISOR
  HEAD
  PROJECT_MANAGER
  HRGA
  CEO_MANAGEMENT
  SYSTEM_ADMIN

  @@map("canonical_role_enum")
}

enum CanonicalFunction {
  Engineering
  Quality
  OperationsInfrastructure @map("Operations & Infrastructure")
  RnD                      @map("R&D")
  Delivery
  BusinessDevelopment      @map("Business Development")
  SalesEnablementPresales  @map("Sales Enablement & Presales")
  Finance
  HRGA
  Management

  @@map("canonical_function_enum")
}

enum PolicyCategory {
  CHECKIN_TIMING
  BLOCKER_SLA
  COMPLIANCE_THRESHOLD
  CORRECTION_WINDOW
  NOTIFICATION_REMINDER_THRESHOLD

  @@map("policy_category_enum")
}

enum NotificationChannel {
  IN_APP_CENTER
  BROWSER_PUSH
  EMAIL

  @@map("notification_channel_enum")
}

enum NotificationStatus {
  QUEUED
  SENT
  READ
  FAILED

  @@map("notification_status_enum")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String     @map("full_name") @db.VarChar(150)
  email             String     @unique @db.VarChar(255)
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  status            UserStatus @default(INVITED)
  mustResetPassword Boolean    @default(false) @map("must_reset_password")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  sessions                   Session[]
  sentInvitations            UserInvitation[]             @relation("CreatedInvitations")
  invitation                 UserInvitation[]             @relation("UserInvitations")
  orgAssignments             OrganizationalAssignment[]   @relation("UserOrgAssignments")
  managedOrgAssignments      OrganizationalAssignment[]   @relation("ManagerOrgAssignments")
  createdOrgAssignments      OrganizationalAssignment[]   @relation("CreatedOrgAssignments")
  managedProjects            ProjectAuthorityMapping[]    @relation("ProjectManagerAuthority")
  reviewedProjects           ProjectAuthorityMapping[]    @relation("EscalationReviewerAuthority")
  createdProjectAuthorities  ProjectAuthorityMapping[]    @relation("CreatedProjectAuthorities")
  delegatedReviewAssignments TemporaryReviewerAssignment[] @relation("DelegateReviewAssignments")
  createdReviewAssignments   TemporaryReviewerAssignment[] @relation("CreatedReviewAssignments")
  createdPolicies            Policy[]                     @relation("CreatedPolicies")
  policyOwnerAssignments     PolicyOwnerAssignment[]      @relation("PolicyOwnerAssignments")
  createdPolicyOwners        PolicyOwnerAssignment[]      @relation("CreatedPolicyOwners")
  notifications              Notification[]
  auditLogs                  AuditLog[]
  dailyRecords               DailyAccountabilityRecord[]
  assignedAdditionalWorks    AdditionalWork[]             @relation("AssignedAdditionalWorks")
  raisedBlockers             BlockerTicket[]              @relation("RaisedBlockers")
  assignedBlockers           BlockerTicket[]              @relation("AssignedBlockers")
  supportContributions       SupportContribution[]
  createdHolidays            CompanyHoliday[]
  leaveRequests              LeaveRequest[]               @relation("UserLeaveRequests")
  reviewedLeaveRequests      LeaveRequest[]               @relation("ReviewedLeaveRequests")
  subjectManagerNotes        ManagerNote[]                @relation("SubjectManagerNotes")
  authoredManagerNotes       ManagerNote[]                @relation("AuthoredManagerNotes")
  complianceEvents           ComplianceEvent[]

  @@map("users")
}

model UserInvitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  tokenHash        String           @unique @map("token_hash") @db.VarChar(255)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz()
  usedAt           DateTime?        @map("used_at") @db.Timestamptz()
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz()
  revocationReason String?          @map("revocation_reason") @db.Text
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user      User @relation("UserInvitations", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("CreatedInvitations", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("user_invitations")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(255)
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz()
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OrganizationalAssignment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  jobTitle         String            @map("job_title") @db.VarChar(150)
  role             CanonicalRole
  function         CanonicalFunction
  directManagerId  String?           @map("direct_manager_id") @db.Uuid
  effectiveDate    DateTime          @map("effective_date") @db.Date
  endDate          DateTime?         @map("end_date") @db.Date
  assignmentReason String            @map("assignment_reason") @db.Text
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user          User  @relation("UserOrgAssignments", fields: [userId], references: [id], onDelete: Restrict)
  directManager User? @relation("ManagerOrgAssignments", fields: [directManagerId], references: [id], onDelete: Restrict)
  createdBy     User  @relation("CreatedOrgAssignments", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([userId, effectiveDate, endDate], map: "idx_org_active_lookup")
  @@map("organizational_assignments")
}

model ProjectAuthorityMapping {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectCode          String            @map("project_code") @db.VarChar(50)
  projectName          String            @map("project_name") @db.VarChar(150)
  projectManagerId     String            @map("project_manager_id") @db.Uuid
  escalationReviewerId String            @map("escalation_reviewer_id") @db.Uuid
  involvedFunction     CanonicalFunction @map("involved_function")
  effectiveDate        DateTime          @map("effective_date") @db.Date
  endDate              DateTime?         @map("end_date") @db.Date
  assignmentReason     String            @map("assignment_reason") @db.Text
  createdByUserId      String            @map("created_by_user_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  projectManager     User @relation("ProjectManagerAuthority", fields: [projectManagerId], references: [id], onDelete: Restrict)
  escalationReviewer User @relation("EscalationReviewerAuthority", fields: [escalationReviewerId], references: [id], onDelete: Restrict)
  createdBy          User @relation("CreatedProjectAuthorities", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([projectCode, effectiveDate, endDate], map: "idx_pa_active_lookup")
  @@map("project_authority_mappings")
}

model TemporaryReviewerAssignment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegateUserId   String            @map("delegate_user_id") @db.Uuid
  targetFunction   CanonicalFunction @map("target_function")
  delegationReason String            @map("delegation_reason") @db.Text
  effectiveDate    DateTime          @map("effective_date") @db.Date
  expiryDate       DateTime          @map("expiry_date") @db.Date
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  delegateUser User @relation("DelegateReviewAssignments", fields: [delegateUserId], references: [id], onDelete: Restrict)
  createdBy    User @relation("CreatedReviewAssignments", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("temporary_reviewer_assignments")
}

model Policy {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category            PolicyCategory
  configurationValues Json           @map("configuration_values") @db.JsonB
  isIllustrative      Boolean        @default(false) @map("is_illustrative")
  effectiveDate       DateTime       @map("effective_date") @db.Date
  endDate             DateTime?      @map("end_date") @db.Date
  createdByUserId     String         @map("created_by_user_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  createdBy User @relation("CreatedPolicies", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("policies")
}

model PolicyOwnerAssignment {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  policyCategory  PolicyCategory @map("policy_category")
  effectiveDate   DateTime       @map("effective_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  user      User @relation("PolicyOwnerAssignments", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("CreatedPolicyOwners", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("policy_owner_assignments")
}

model Notification {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId   String              @map("recipient_user_id") @db.Uuid
  triggerType       String              @map("trigger_type") @db.VarChar(100)
  channel           NotificationChannel
  title             String              @db.VarChar(200)
  message           String              @db.Text
  actionUrl         String?             @map("action_url") @db.VarChar(500)
  relatedEntityType String?             @map("related_entity_type") @db.VarChar(64)
  relatedEntityId   String?             @map("related_entity_id") @db.Uuid
  status            NotificationStatus  @default(QUEUED)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz()
  readAt            DateTime?           @map("read_at") @db.Timestamptz()
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actionCode        String   @map("action_code") @db.VarChar(100)
  relatedEntityType String   @map("related_entity_type") @db.VarChar(64)
  relatedEntityId   String   @map("related_entity_id") @db.Uuid
  valueBefore       Json?    @map("value_before") @db.JsonB
  valueAfter        Json?    @map("value_after") @db.JsonB
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  userAgent         String?  @map("user_agent") @db.Text
  timestamp         DateTime @default(now()) @db.Timestamptz()

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

enum TimingStatus {
  ON_TIME
  LATE
  NO_SUBMISSION
  EXEMPTED
  APPROVED_LEAVE

  @@map("timing_status_enum")
}

enum DailyRiskStatus {
  GREEN
  AMBER
  RED
  NOT_APPLICABLE_NO_COMMITMENT

  @@map("daily_risk_status_enum")
}

enum CommitmentRisk {
  GREEN
  AMBER
  RED

  @@map("commitment_risk_enum")
}

enum CommitmentOutcome {
  COMPLETED
  PARTIALLY_COMPLETED
  NOT_COMPLETED
  CANCELLED

  @@map("commitment_outcome_enum")
}

enum ContinuationStatus {
  CONTINUE
  DO_NOT_CONTINUE

  @@map("continuation_status_enum")
}

enum AdditionalWorkReason {
  NEWLY_ASSIGNED
  MISSED_IN_PLANNING
  PRIORITY_CHANGE
  OPERATIONAL_INCIDENT
  OTHER

  @@map("additional_work_reason_enum")
}

enum BlockerType {
  TECHNICAL
  REQUIREMENT
  CLIENT
  VENDOR
  RESOURCE
  APPROVAL
  INFRA
  FINANCE
  LEGAL
  OTHER

  @@map("blocker_type_enum")
}

enum BlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("blocker_severity_enum")
}

enum BlockerImpact {
  TASK
  MILESTONE
  PROJECT
  PRODUCTION
  CLIENT
  FINANCIAL
  COMPLIANCE

  @@map("blocker_impact_enum")
}

enum AuthorityContext {
  ORGANIZATIONAL_AUTHORITY
  PROJECT_AUTHORITY

  @@map("authority_context_enum")
}

enum BlockerStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  ACCEPTED_RISK

  @@map("blocker_status_enum")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_status_enum")
}

model DailyAccountabilityRecord {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  workDate              DateTime        @map("work_date") @db.Date
  orgContextSnapshot    Json            @map("org_context_snapshot") @db.JsonB
  policySnapshot        Json            @map("policy_snapshot") @db.JsonB
  morningSubmittedAt    DateTime?       @map("morning_submitted_at") @db.Timestamptz()
  eodSubmittedAt        DateTime?       @map("eod_submitted_at") @db.Timestamptz()
  morningTiming         TimingStatus    @default(NO_SUBMISSION) @map("morning_timing")
  eodTiming             TimingStatus    @default(NO_SUBMISSION) @map("eod_timing")
  initialDailyStatus    DailyRiskStatus @default(NOT_APPLICABLE_NO_COMMITMENT) @map("initial_daily_status")
  finalDailyStatus      DailyRiskStatus? @map("final_daily_status")
  zeroCommitmentReason  String?         @map("zero_commitment_reason") @db.Text
  morningCutoffLockedAt DateTime?       @map("morning_cutoff_locked_at") @db.Timestamptz()
  eodCutoffLockedAt     DateTime?       @map("eod_cutoff_locked_at") @db.Timestamptz()
  overrideReason        String?         @map("override_reason") @db.Text
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  commitments      Commitment[]
  additionalWorks  AdditionalWork[]
  complianceEvents ComplianceEvent[]

  @@unique([userId, workDate], map: "uq_user_work_date")
  @@index([userId, workDate], map: "idx_dar_user_date")
  @@map("daily_accountability_records")
}

model Commitment {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyRecordId      String              @map("daily_record_id") @db.Uuid
  sequenceNo         Int                 @map("sequence_no") @db.SmallInt
  taskText           String              @map("task_text") @db.Text
  referenceLink      String?             @map("reference_link") @db.VarChar(500)
  initialRisk        CommitmentRisk      @map("initial_risk")
  knownBlockerNote   String?             @map("known_blocker_note") @db.Text
  supportNeeded      String?             @map("support_needed") @db.Text
  isCarryOver        Boolean             @default(false) @map("is_carry_over")
  carryOverDaysCount Int                 @default(0) @map("carry_over_days_count")
  originCommitmentId String?             @map("origin_commitment_id") @db.Uuid
  outcome            CommitmentOutcome?
  outcomeReason      String?             @map("outcome_reason") @db.Text
  continuation       ContinuationStatus?
  continuationReason String?             @map("continuation_reason") @db.Text
  isMorningLocked    Boolean             @default(false) @map("is_morning_locked")
  isEodLocked        Boolean             @default(false) @map("is_eod_locked")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  dailyRecord      DailyAccountabilityRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  originCommitment Commitment?               @relation("CommitmentCarryOver", fields: [originCommitmentId], references: [id], onDelete: Restrict)
  childCommitments Commitment[]              @relation("CommitmentCarryOver")
  blockers         BlockerTicket[]

  @@unique([dailyRecordId, sequenceNo], map: "uq_record_sequence")
  @@index([originCommitmentId], map: "idx_commitments_origin")
  @@map("commitments")
}

model AdditionalWork {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyRecordId      String               @map("daily_record_id") @db.Uuid
  taskText           String               @map("task_text") @db.Text
  reason             AdditionalWorkReason
  assignedByUserId   String?              @map("assigned_by_user_id") @db.Uuid
  outcome            CommitmentOutcome?
  outcomeReason      String?              @map("outcome_reason") @db.Text
  continuation       ContinuationStatus?
  continuationReason String?              @map("continuation_reason") @db.Text
  isEodLocked        Boolean              @default(false) @map("is_eod_locked")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  dailyRecord    DailyAccountabilityRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  assignedByUser User?                     @relation("AssignedAdditionalWorks", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@map("additional_works")
}

model BlockerTicket {
  id                            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raisedByUserId                String           @map("raised_by_user_id") @db.Uuid
  linkedCommitmentId            String?          @map("linked_commitment_id") @db.Uuid
  type                          BlockerType
  severity                      BlockerSeverity
  impact                        BlockerImpact
  description                   String           @db.Text
  ownerNeededType               AuthorityContext @map("owner_needed_type")
  assignedOwnerId               String           @map("assigned_owner_id") @db.Uuid
  projectCodeReference          String?          @map("project_code_reference") @db.VarChar(50)
  status                        BlockerStatus    @default(OPEN)
  raisedAt                      DateTime         @default(now()) @map("raised_at") @db.Timestamptz()
  targetResolutionAt            DateTime?        @map("target_resolution_at") @db.Timestamptz()
  acknowledgedAt                DateTime?        @map("acknowledged_at") @db.Timestamptz()
  resolvedAt                    DateTime?        @map("resolved_at") @db.Timestamptz()
  closedAt                      DateTime?        @map("closed_at") @db.Timestamptz()
  resolutionNote                String?          @map("resolution_note") @db.Text
  riskAcceptanceJustification   String?          @map("risk_acceptance_justification") @db.Text
  riskMitigationPlan            String?          @map("risk_mitigation_plan") @db.Text
  autoEscalationLevel           Int              @default(0) @map("auto_escalation_level") @db.SmallInt
  lastEscalatedAt               DateTime?        @map("last_escalated_at") @db.Timestamptz()
  createdAt                     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  raisedBy             User                  @relation("RaisedBlockers", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  assignedOwner        User                  @relation("AssignedBlockers", fields: [assignedOwnerId], references: [id], onDelete: Restrict)
  linkedCommitment     Commitment?           @relation(fields: [linkedCommitmentId], references: [id], onDelete: SetNull)
  supportContributions SupportContribution[]

  @@index([status, severity, targetResolutionAt], map: "idx_blockers_status_severity")
  @@index([assignedOwnerId, status], map: "idx_blockers_assigned_owner")
  @@map("blocker_tickets")
}

model SupportContribution {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId       String   @map("blocker_id") @db.Uuid
  supporterUserId String   @map("supporter_user_id") @db.Uuid
  actionTaken     String   @map("action_taken") @db.Text
  resultNote      String   @map("result_note") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  blocker   BlockerTicket @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  supporter User          @relation(fields: [supporterUserId], references: [id], onDelete: Restrict)

  @@map("support_contributions")
}

model CompanyHoliday {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  holidayDate     DateTime @unique @map("holiday_date") @db.Date
  holidayName     String   @map("holiday_name") @db.VarChar(150)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([holidayDate], map: "idx_holidays_date")
  @@map("company_holidays")
}

model LeaveRequest {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  startDate          DateTime    @map("start_date") @db.Date
  endDate            DateTime    @map("end_date") @db.Date
  leaveType          String      @map("leave_type") @db.VarChar(50)
  reason             String      @db.Text
  status             LeaveStatus @default(PENDING)
  reviewedByUserId   String?     @map("reviewed_by_user_id") @db.Uuid
  reviewNote         String?     @map("review_note") @db.Text
  reviewedAt         DateTime?   @map("reviewed_at") @db.Timestamptz()
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user       User  @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("ReviewedLeaveRequests", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, startDate, endDate, status], map: "idx_leave_user_range")
  @@map("leave_requests")
}

enum ManagerNoteType {
  COACHING
  RECOGNITION
  CORRECTIVE

  @@map("manager_note_type_enum")
}

enum NoteVisibility {
  CONFIDENTIAL_MANAGER_ONLY
  SHARED_WITH_EMPLOYEE
  HRGA_ESCALATION

  @@map("note_visibility_enum")
}

enum ComplianceEventStage {
  NO_SUBMISSION
  PATTERN_FLAG_3X
  COACHING_LOGGED
  RECORDED_WARNING
  FORMAL_HR_ESCALATION

  @@map("compliance_event_stage_enum")
}

model ManagerNote {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectUserId     String          @map("subject_user_id") @db.Uuid
  authorUserId      String          @map("author_user_id") @db.Uuid
  noteType          ManagerNoteType @map("note_type")
  visibility        NoteVisibility
  content           String          @db.Text
  relatedEntityType String?         @map("related_entity_type") @db.VarChar(64)
  relatedEntityId   String?         @map("related_entity_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  subjectUser       User            @relation("SubjectManagerNotes", fields: [subjectUserId], references: [id], onDelete: Restrict)
  authorUser        User            @relation("AuthoredManagerNotes", fields: [authorUserId], references: [id], onDelete: Restrict)
  complianceEvents  ComplianceEvent[]

  @@map("manager_notes")
}

model ComplianceEvent {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  eventDate             DateTime             @map("event_date") @db.Date
  stage                 ComplianceEventStage
  relatedDailyRecordId  String?              @map("related_daily_record_id") @db.Uuid
  policySnapshot        Json                 @map("policy_snapshot") @db.JsonB
  followUpStatus        String               @default("OPEN") @map("follow_up_status") @db.VarChar(50)
  followUpManagerNoteId String?              @map("follow_up_manager_note_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  dailyRecord           DailyAccountabilityRecord? @relation(fields: [relatedDailyRecordId], references: [id], onDelete: SetNull)
  followUpManagerNote   ManagerNote?         @relation(fields: [followUpManagerNoteId], references: [id], onDelete: SetNull)

  @@index([userId, eventDate, stage], map: "idx_compliance_user_date")
  @@map("compliance_events")
}
