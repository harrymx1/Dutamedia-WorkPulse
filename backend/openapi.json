  "info": {
    "title": "WorkPulse API",
    "description": "Kontrak Resmi WorkPulse — Daily Accountability & Blocker Log System API v1.0 (Dutamedia) sesuai SAD Section 10",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Autentikasi dan sesi login (SAD §10.1)"
    },
    {
      "name": "Identity",
      "description": "Organisasi, pengguna, tim, departemen, dan proyek (SAD §10.2)"
    },
    {
      "name": "DailyAccountability",
      "description": "Check-in harian pagi & sore, komitmen, dan tugas tambahan (SAD §10.3)"
    },
    {
      "name": "Blocker",
      "description": "Manajemen blocker, kontribusi bantuan, dan resolusi (SAD §10.4)"
    },
    {
      "name": "CorrectionRequest",
      "description": "Pengajuan dan review koreksi record (SAD §10.5)"
    },
    {
      "name": "Exception",
      "description": "Cuti, libur, dan dispensasi kehadiran (SAD §10.6)"
    },
    {
      "name": "ManagerNote",
      "description": "Catatan manajerial dan coaching (SAD §10.7)"
    },
    {
      "name": "Compliance",
      "description": "Pelanggaran kompensasi dan progres sanksi (SAD §10.8)"
    },
    {
      "name": "Policy",
      "description": "Pengaturan kebijakan dan penugasan policy owner (SAD §10.9)"
    },
    {
      "name": "Notification",
      "description": "Pengaturan notifikasi dan riwayat pemberitahuan (SAD §10.10)"
    },
    {
      "name": "Reporting",
      "description": "Laporan agregat dan analitik tim/fungsi/manajemen (SAD §10.11)"
    },
    {
      "name": "FileStorage",
      "description": "Upload signed URL dan unduhan bukti (SAD §10.12)"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token",
        "description": "Session HttpOnly Cookie JWT Token (SAD §8.1)"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Double Submit Cookie CSRF Token (SAD §8.5)"
      }
    },
    "schemas": {}
  }
