# =============================================================================
# WorkPulse Backend Environment Configuration (SAD §21.2)
# =============================================================================

# Application
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL direct connection)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workpulse?sslmode=require"

# Authentication & Security
# Generate secure secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
ALLOWED_ORIGIN="http://localhost:5173"

# Notification Delivery (Brevo Email API)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="notifications@dutamedia.com"
BREVO_SENDER_NAME="WorkPulse Notification"

# File & Evidence Storage (S3-Compatible: Cloudflare R2 / MinIO / AWS S3)
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_BUCKET="workpulse-evidence"
STORAGE_REGION="auto"
